# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# --- MySQL (same database the Python pipeline uses; see config/appsettings.yml) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=sa
DB_PASSWORD=Augday@11
DB_NAME=airflow
DB_CONNECTION_LIMIT=10

# --- Interface secret encryption (AES-256-GCM) ---
# 32-byte key, base64 or hex encoded. Generate: openssl rand -base64 32
# The Python pipeline must be given the SAME key (env INTERFACE_SECRET_KEY) so it
# can decrypt these columns when it reads interfaceconfiguration.
INTERFACE_SECRET_KEY=

# --- Airflow REST API (for the "Run now" trigger) ---
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DAG_ID=invoice_execution_dag
