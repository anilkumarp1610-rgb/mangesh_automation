# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# --- MySQL (same database the Python pipeline uses; the pipeline has its own .env at the project root) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sa
MYSQL_PASSWORD=Augday@11
MYSQL_DATABASE=airflow
MYSQL_CONNECTION_LIMIT=10

# --- Interface secret encryption (AES-256-GCM) ---
# 32-byte key, base64 or hex encoded. Generate: openssl rand -base64 32
# The Python pipeline must be given the SAME key (env INTERFACE_SECRET_KEY) so it
# can decrypt these columns when it reads interfaceconfiguration.
INTERFACE_SECRET_KEY=

# --- Airflow REST API (for the "Run now" trigger) ---
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DAG_ID=invoice_execution_dag

# --- Direct pipeline trigger (Reprocess button on a batch's detail page) ---
# Path/command used to run the Python pipeline directly: spawns
#   <PIPELINE_PYTHON_EXECUTABLE> process_invoices.py --interface-id <id> --ap-batch-name <name>
# with cwd = PIPELINE_SCRIPTS_DIR. Point PIPELINE_SCRIPTS_DIR at the Python
# pipeline's scripts/ folder (default assumes tracker/backend and scripts/ are
# siblings under the same repo root, as in this project's layout).
PIPELINE_PYTHON_EXECUTABLE=python
PIPELINE_SCRIPTS_DIR=../../scripts
PIPELINE_TRIGGER_POLL_TIMEOUT_MS=15000
