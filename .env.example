# Environment for the Python pipeline (scripts/). Copy to .env and fill in; keep .env out of git.
# Real environment variables win over this file; PIPELINE_ENV_FILE=/path/to/file points at a different one.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_SIZE=5

# 32-byte key (base64 or hex): decrypts interfaceconfiguration secret columns.
# Must be the same value the tracker used to encrypt them. Generate: openssl rand -base64 32
INTERFACE_SECRET_KEY=
